# Copy this file to .env (or .env.production for the deployed build) and fill
# in real endpoint URLs to have the landing page's Feedback and Waitlist forms
# POST directly to a form backend (e.g. Formspree, EmailJS, Getform).
#
# Leave a variable blank/unset to fall back to opening a pre-filled mailto:
# link to timothylai0601@gmail.com instead.
#
# Vite only reads these at BUILD time, so for the GitHub Pages deploy you must
# have the .env file present (or the vars exported in your shell/CI) *before*
# running `npm run build` / `npm run deploy` — editing .env after a build has
# no effect until you rebuild.

VITE_FEEDBACK_FORM_ENDPOINT=
VITE_WAITLIST_FORM_ENDPOINT=
